{
  "name": "backend-bun",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- bun --hot ./src/server.ts",
    "prod": "dotenv -e .env.production -- bun ./src/server.ts",
    "build": "bun ./build.ts",
    "db:generate": "dotenv -e .env -- drizzle-kit generate",
    "db:migrate": "dotenv -e .env -- drizzle-kit migrate"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^1.0.0-rc.4",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.22.5"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^5.2.1",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  }
}
